# "development" or "production". In production this enforces a real
# JWT_SECRET_KEY (refuses to start with the placeholder below) and
# auto-disables the /docs, /redoc, and /openapi.json endpoints unless
# ENABLE_DOCS is explicitly set to true.
ENVIRONMENT=development
# ENABLE_DOCS=true

DATABASE_URL=mysql+pymysql://resume_user:resume_pass@localhost:3306/resume_builder

# Generate a real one for anything beyond local dev: openssl rand -hex 32
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

AI_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=openai/gpt-oss-120b

CORS_ORIGINS=["http://localhost:5173"]

# "text" for readable local logs, "json" for production log aggregators
LOG_FORMAT=text

# Auth endpoint throttling (spec §37) — format: "<count>/<period>", e.g. "10/minute"
LOGIN_RATE_LIMIT=10/minute
REGISTER_RATE_LIMIT=5/minute
